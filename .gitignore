# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# npm auth (holds GitHub Packages token — must never be committed)
.npmrc

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Firebase config (secrets — supply per environment, do not commit)
/google-services.json
/GoogleService-Info.plist

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# gradle output of the local Expo modules (the sources next to it are tracked)
/modules/*/android/build/

ios_distribution.cer
