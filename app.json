{
  "expo": {
    "name": "INTIP",
    "slug": "intip-mobile-app",
    "version": "3.0.9",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "intipmobileapp",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "kr.inuappcenter.intip",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:intip.inuappcenter.kr",
        "applinks:intip-test.pages.dev"
      ],
      "googleServicesFile": "./GoogleService-Info.plist",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ],
        "NSCameraUsageDescription": "게시판 및 채팅 업로드용 사진 촬영을 위해 카메라 접근 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "게시판 및 채팅 사진 업로드를 위해 사진첩 접근 권한이 필요합니다.",
        "NSPhotoLibraryAddUsageDescription": "촬영한 사진을 저장하기 위해 사진첩 접근 권한이 필요합니다.",
        "NSLocationWhenInUseUsageDescription": "캠퍼스맵 내 위치 표시 및 주변친구 찾기 기능을 위해 위치 권한이 필요합니다."
      }
    },
    "android": {
      "package": "inu.appcenter.intip_android",
      "versionCode": 22,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "intip.inuappcenter.kr"
            },
            {
              "scheme": "https",
              "host": "intip-test.pages.dev"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "./plugins/withDefaultNotificationChannel",
      "./plugins/withAndroidReleaseSigning",
      "./plugins/withIOSManualSigning",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "extraMavenRepos": [
              "../../node_modules/@notifee/react-native/android/libs"
            ]
          }
        }
      ],
      [
        "react-native-permissions",
        {
          "iosPermissions": [
            "Camera",
            "LocationWhenInUse",
            "PhotoLibrary",
            "Notifications"
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4dd31317-0fde-484b-bbe5-c445f82ae718",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4dd31317-0fde-484b-bbe5-c445f82ae718"
      }
    },
    "owner": "gang_03"
  }
}
