{
  "expo": {
    "name": "INTIP",
    "slug": "intip-mobile-app",
    "version": "3.0.11",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "intipmobileapp",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "kr.inuappcenter.intip",
      "buildNumber": "24",
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:intip.inuappcenter.kr",
        "applinks:intip-test.pages.dev"
      ],
      "googleServicesFile": "./GoogleService-Info.plist",
      "icon": "./assets/expo.icon",
      "entitlements": {
        "aps-environment": "production"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["remote-notification", "fetch"],
        "NSCameraUsageDescription": "게시판 및 채팅 업로드용 사진 촬영을 위해 카메라 접근 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "게시판 및 채팅 사진 업로드를 위해 사진첩 접근 권한이 필요합니다.",
        "NSPhotoLibraryAddUsageDescription": "촬영한 사진을 저장하기 위해 사진첩 접근 권한이 필요합니다.",
        "NSLocationWhenInUseUsageDescription": "캠퍼스맵 내 위치 표시 및 주변친구 찾기 기능을 위해 위치 권한이 필요합니다."
      }
    },
    "android": {
      "package": "inu.appcenter.intip_android",
      "versionCode": 24,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/ic_launcher_foreground.png",
        "backgroundImage": "./assets/images/ic_launcher_background.png",
        "monochromeImage": "./assets/images/ic_launcher_monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "intip.inuappcenter.kr"
            },
            {
              "scheme": "https",
              "host": "intip-test.pages.dev"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#043799",
          "image": "./assets/splash/logo-splash.png",
          "imageWidth": 178,
          "resizeMode": "contain"
        }
      ],
      "@react-native-firebase/app",
      "@react-native-firebase/messaging",
      "./plugins/withDefaultNotificationChannel",
      "./plugins/withAndroidReleaseSigning",
      "./plugins/withIOSManualSigning",
      "./plugins/withWorkManagerVersionAlign",
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": ["text/*"],
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          },
          "android": {
            "extraMavenRepos": [
              "../../node_modules/@notifee/react-native/android/libs"
            ]
          }
        }
      ],
      [
        "react-native-permissions",
        {
          "iosPermissions": [
            "Camera",
            "LocationWhenInUse",
            "PhotoLibrary",
            "Notifications"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-widgets",
        {
          "bundleIdentifier": "kr.inuappcenter.intip.widget",
          "groupIdentifier": "group.kr.inuappcenter.intip.container",
          "enablePushNotifications": true,
          "widgets": [
            {
              "name": "TestWidget",
              "displayName": "인팁 테스트 위젯",
              "description": "위젯 파이프라인 확인용 테스트 위젯이에요.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge"
              ]
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/4dd31317-0fde-484b-bbe5-c445f82ae718",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4dd31317-0fde-484b-bbe5-c445f82ae718"
      }
    },
    "owner": "gang_03"
  }
}
